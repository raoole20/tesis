# Copia este archivo como .env y llena los valores. .env está en .gitignore.
#
# Son los mismos datos que usa la app (cupo/dart_define.json): la URL del
# proyecto y la clave publicable (anon). Nunca pongas aquí la service_role:
# la protección real es la función panel_admin(), que exige una cuenta con
# rol 'administrador'.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=pega-aqui-la-clave-anon
