---
import Base from '../layouts/Base.astro';

let error =
  Astro.url.searchParams.get('error') === 'permiso'
    ? 'Esta cuenta no tiene permisos de administrador.'
    : '';
let email = '';

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  email = String(datos.get('email') ?? '').trim();
  const clave = String(datos.get('clave') ?? '');

  if (!email || !clave) {
    error = 'Escribe el correo y la clave.';
  } else {
    const { error: fallo } = await Astro.locals.supabase.auth.signInWithPassword({
      email,
      password: clave,
    });
    if (!fallo) return Astro.redirect('/');
    error = /invalid login credentials/i.test(fallo.message)
      ? 'Correo o clave incorrectos.'
      : `No se pudo entrar: ${fallo.message}`;
  }
}
---

<Base titulo="Cupo · Entrar al panel">
  <main>
    <form method="post">
      <span class="logo">Cupo</span>
      <h1>Panel de administración</h1>
      <p class="lead">Entra con una cuenta de administrador.</p>

      <label>
        <span>Correo</span>
        <input class="control" type="email" name="email" value={email} autocomplete="username" required autofocus />
      </label>
      <label>
        <span>Clave</span>
        <input class="control" type="password" name="clave" autocomplete="current-password" required />
      </label>

      {error && <p class="aviso aviso--error" role="alert">{error}</p>}

      <button class="boton boton--primario" type="submit">Entrar</button>
    </form>
  </main>
</Base>

<style>
  main {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px 16px;
  }
  form {
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .logo { font-size: 46px; text-align: center; }
  h1 {
    margin: 0;
    text-align: center;
    font: 600 34px/1 var(--font-titulo);
    letter-spacing: 0.2px;
  }
  .lead { margin: -8px 0 8px; text-align: center; color: var(--text-secondary); }
  label { display: flex; flex-direction: column; gap: 6px; }
  label span { font: 700 13px/1.3 var(--font-ui); }
  .boton { margin-top: 8px; }
</style>
