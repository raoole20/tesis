# Copia este archivo a .env y llena los valores. .env está en .gitignore.
#
# Token personal de Supabase, para el servidor MCP (ver el Apéndice C de cupo/README.md).
# Se genera en https://supabase.com/dashboard/account/tokens
# Vale por TODA la cuenta, no por un proyecto. Bórralo del panel al terminar.
SUPABASE_ACCESS_TOKEN=sbp_pega-aqui-tu-token

# Referencia del proyecto: la parte xxxx de https://xxxx.supabase.co.
# Limita el servidor MCP a ese proyecto. Opcional, pero recomendada.
SUPABASE_PROJECT_REF=xxxx
